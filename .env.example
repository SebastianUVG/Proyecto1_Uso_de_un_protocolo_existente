# Path to the local SQLite database used by the inventory application.
INVENTORY_DB_PATH=data/inventory.db

# OpenAI credentials and model configuration. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=60

# Local MCP client and chatbot settings.
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_LOG_PATH=logs/mcp.jsonl
MAX_TOOL_ITERATIONS=5

# Inventory MCP transport. The HTTP server binds to localhost by default.
INVENTORY_MCP_TRANSPORT=stdio
INVENTORY_MCP_URL=http://127.0.0.1:8000/mcp
INVENTORY_MCP_HTTP_HOST=127.0.0.1
INVENTORY_MCP_HTTP_PORT=8000

# Browser-facing Web UI. It uses a different port from Inventory MCP HTTP.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Optional host-side ports published by Docker Compose.
INVENTORY_MCP_PUBLISHED_PORT=8000
WEB_PUBLISHED_PORT=8080

# External servers are opt-in. Their common sandbox is relative to the project.
FILESYSTEM_MCP_ENABLED=false
GIT_MCP_ENABLED=false
MCP_DEMO_ROOT=demo_workspace
GIT_MCP_REPOSITORY=repository

# Optional command overrides. Arguments must be JSON arrays of strings.
# FILESYSTEM_MCP_COMMAND=npx
# FILESYSTEM_MCP_ARGS=["-y","@modelcontextprotocol/server-filesystem"]
# GIT_MCP_COMMAND=python
# GIT_MCP_ARGS=["-m","mcp_server_git"]
